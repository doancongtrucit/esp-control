{
  "serial_port": "auto",
  "baud": 115200,
  "interval_seconds": 2.0,
  "disk_path": "auto",
  "log_file": "control-deck.log",
  "librehardwaremonitor": {
    "enabled": {
      "windows": true,
      "linux": false,
      "macos": false
    },
    "url": "http://127.0.0.1:8085/data.json",
    "timeout_seconds": 0.5
  },
  "macros": [
    {
      "id": 1,
      "label": "ChatGPT",
      "action": "url",
      "value": "https://chatgpt.com/",
      "icon": "chat"
    },
    {
      "id": 2,
      "label": "Ollama",
      "action": "service",
      "health_url": "http://127.0.0.1:11434/api/tags",
      "hidden": true,
      "value": {
        "windows": [
          "ollama",
          "serve"
        ],
        "linux": [
          "ollama",
          "serve"
        ],
        "macos": [
          "ollama",
          "serve"
        ]
      },
      "icon": "chip"
    },
    {
      "id": 3,
      "label": "Voice Server",
      "action": "command",
      "new_console": true,
      "value": {
        "windows": [
          "cmd.exe",
          "/c",
          "C:\\Path\\To\\START_VOICE_SERVER.cmd"
        ],
        "linux": null,
        "macos": null
      },
      "working_directory": {
        "windows": "C:\\Path\\To",
        "linux": null,
        "macos": null
      },
      "icon": "headset"
    },
    {
      "id": 4,
      "label": "Terminal",
      "action": "command",
      "value": {
        "windows": [
          "wt.exe"
        ],
        "linux": [
          "x-terminal-emulator"
        ],
        "macos": [
          "open",
          "-a",
          "Terminal"
        ]
      },
      "icon": "controls"
    },
    {
      "id": 5,
      "label": "Task Manager",
      "action": "command",
      "value": {
        "windows": [
          "taskmgr.exe"
        ],
        "linux": [
          "gnome-system-monitor"
        ],
        "macos": [
          "open",
          "-a",
          "Activity Monitor"
        ]
      },
      "icon": "activity"
    },
    {
      "id": 6,
      "label": "Lock PC",
      "action": "command",
      "value": {
        "windows": [
          "rundll32.exe",
          "user32.dll,LockWorkStation"
        ],
        "linux": [
          "loginctl",
          "lock-session"
        ],
        "macos": [
          "pmset",
          "displaysleepnow"
        ]
      },
      "confirm_hold": true,
      "icon": "lock"
    }
  ],
  "gold": {
    "enabled": true,
    "refresh_minutes": 15,
    "url": "https://www.vang.today/api/prices",
    "items": [
      [
        "SJL1L10",
        "SJC bar"
      ],
      [
        "SJ9999",
        "SJC ring"
      ],
      [
        "DOHNL",
